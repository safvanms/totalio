// Totalio data model: LOCAL DEVELOPMENT (SQLite).
// prisma/schema.postgres.prisma is generated from this file by
// `npm run schema:sync`. Edit models here only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts

model User {
  id           String   @id @default(cuid())
  /// Lower-cased, trimmed
  email        String   @unique
  name         String
  /// scrypt$N$r$p$salt$hash
  passwordHash String
  /// Brute-force protection
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  /// Unused: admin access is a separate login now (ADMIN_USERNAME/ADMIN_PASSWORD).
  /// Kept so databases that already have it upgrade without a destructive migration.
  isAdmin      Boolean  @default(false)
  /// Suspended accounts can't sign in; their sessions are ended.
  suspended    Boolean  @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions   Session[]
  categories Category[]
  expenses   Expense[]
  setting    Setting?
}

/// Login session. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  /// Opened by the admin with "Open their account" (not a real sign-in by the user)
  viaAdmin  Boolean  @default(false)

  @@index([userId])
}

// ---------------------------------------------------------------- data
// `userId` is nullable only so that upgrading a database that already holds
// data from before accounts existed never fails. Those rows are assigned to
// the first account created. The application always filters by userId.

model Category {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Short reference code shown in formulas (C1, C2, ...), unique per user
  code        String
  name        String
  description String?
  color       String
  icon        String
  /// "NORMAL" | "CALCULATED" (validated in the application layer)
  type        String   @default("NORMAL")
  /// JSON-encoded FormulaToken[] for calculated categories; null otherwise
  formula     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]
  /// Categories this (calculated) category references in its formula
  dependsOn  CategoryDependency[] @relation("DependentCategory")
  /// Calculated categories that reference this category
  dependents CategoryDependency[] @relation("ReferencedCategory")

  @@unique([userId, code])
  @@index([userId, type])
  @@index([userId, name])
}

/// Edge in the formula dependency graph. Kept in sync with Category.formula on save.
/// onDelete: Restrict on the referenced side prevents deleting a category that a formula uses.
model CategoryDependency {
  categoryId   String
  referencesId String
  category     Category @relation("DependentCategory", fields: [categoryId], references: [id], onDelete: Cascade)
  references   Category @relation("ReferencedCategory", fields: [referencesId], references: [id], onDelete: Restrict)

  @@id([categoryId, referencesId])
  @@index([referencesId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  particular  String
  /// Major currency units, rounded to 2 decimals. Sums are done in minor units.
  amount      Float
  /// Calendar date stored as UTC midnight
  expenseDate DateTime
  description String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, expenseDate])
  @@index([categoryId, expenseDate])
  @@index([userId, particular])
}

/// Per-user application settings
model Setting {
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   String   @default("INR")
  dateFormat String   @default("dd MMM yyyy")
  /// JSON-encoded DashboardPreferences
  dashboard  String   @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Sign-ins to the /admin area (separate from user accounts).
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
}

/// Failed /admin sign-ins, used to lock out repeated guessing per IP.
model AdminLoginFailure {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
