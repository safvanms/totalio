# ---- Local development (SQLite, prisma/schema.prisma) ----
DATABASE_URL="file:./dev.db"

# ---- Production on Vercel (PostgreSQL, prisma/schema.postgres.prisma) ----
# Set these in Vercel -> Project -> Settings -> Environment Variables, not here.
# DATABASE_URL = pooled connection string   (host usually contains "-pooler")
# DIRECT_URL   = direct connection string   (no "-pooler")
# Both should end with ?sslmode=require

# ---- Link previews (optional) ----
# Your public site URL, used for the WhatsApp/Slack/iMessage preview image.
# On Vercel the production domain is detected automatically; set this once you
# attach a custom domain so previews point at it.
# NEXT_PUBLIC_SITE_URL="https://totalio.app"
